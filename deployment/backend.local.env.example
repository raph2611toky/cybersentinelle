# Local Compose ONLY: debug allows HTTP cookies on 127.0.0.1:8080.
# Do not deploy this to public servers.
DEBUG=true
DB_ENGINE=mysql
SECRET_KEY=dev-only-replace-in-production-and-do-not-reuse
ALLOWED_HOSTS=127.0.0.1,localhost,mysql,backend,safidiko-backend
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TRUST_PROXY_SSL_HEADER=false
SWAGGER_ENABLED=true
MYSQL_NAME=safidiko
MYSQL_USER=safidiko_app
MYSQL_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
MYSQL_HOST=mysql
MYSQL_PORT=3306
CELERY_BROKER_URL=redis://safidiko-redis:6379/0
MEDIA_ROOT=/app/media
STUDIO_PRIVATE_ROOT=/app/private_media
CONTENT_ROOT=/app/content
MEDIA_URL=/media/
SWAGGER_PASSWORD=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
