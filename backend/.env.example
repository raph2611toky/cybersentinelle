# DEV : SQLite ; PRODUCTION : MySQL
DEBUG=true
SECRET_KEY=django-insecure-dev-only-change-this
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SWAGGER_ENABLED=true
TRUST_PROXY_SSL_HEADER=false
# DEBUG=false exige les variables suivantes :
MYSQL_NAME=safidiko
MYSQL_USER=safidiko
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# CONTENT_ROOT=/absolute/path/to/backend/content

# Swagger : accès dédié, distinct du compte /admin/
SWAGGER_PASSWORD=
SWAGGER_COOKIE_MAX_AGE=3600
# MEDIA_ROOT=/absolute/path/to/backend/media
# MEDIA_URL=/media/

# Studio / accès fichiers bruts privé
# STUDIO_PRIVATE_ROOT=/absolute/path/to/backend/private_media
STUDIO_MAX_UPLOAD_MB=120
STUDIO_MAX_MEDIA_SECONDS=240
STUDIO_MAX_TTS_CHARS=1200
STUDIO_TTS_DAILY_LIMIT=12
STUDIO_TTS_PROVIDERS=GTTS,GEMINI,ELEVENLABS,GOOGLE_CLOUD
# gTTS français utilise Google Traduction (API non officielle, sans clé).
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Worker Celery / Redis local
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Google Cloud Translation: enable API + billing, and use ADC on the backend only.
GOOGLE_APPLICATION_CREDENTIALS=
# Exemple après téléchargement du JSON de compte de service :
# GOOGLE_APPLICATION_CREDENTIALS=/opt/safidiko/secrets/google-translate.json

# Google Cloud Text-to-Speech : l’API doit être activée et la facturation GCP est requise.
# Le compte de service dans GOOGLE_APPLICATION_CREDENTIALS nécessite texttospeech.voices.list
# et texttospeech.text.synthesize. Gratuit uniquement dans les limites de quota Google.
